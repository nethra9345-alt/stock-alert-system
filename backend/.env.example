# StockPulse AI Configuration - Safe Template (.env.example)
PROJECT_NAME="StockPulse AI"
ENVIRONMENT="development"
DEBUG=True

# Primary Database: PostgreSQL (using psycopg 3)
DATABASE_URL="postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/stockpulse"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cryptographic Authentication & JWT Secret (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY="<REPLACE_WITH_SECURE_RANDOMLY_GENERATED_JWT_SECRET_HEX>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Request Security
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_SIZE_BYTES=10485760

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# Optional AI / LLM Keys (Fallbacks to deterministic research engine if unset)
GEMINI_API_KEY="<OPTIONAL_GOOGLE_GEMINI_API_KEY>"
GEMINI_MODEL="gemini-1.5-flash"
GROQ_API_KEY="<OPTIONAL_GROQ_API_KEY>"

# Server Binding
HOST="0.0.0.0"
PORT=8000
