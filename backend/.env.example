# StockPulse AI Configuration
PROJECT_NAME="StockPulse AI"
ENVIRONMENT="development"
DEBUG=True

# Primary Database: PostgreSQL (using psycopg 3)
# Replace <PASSWORD> with your local postgres user password
DATABASE_URL="postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/stockpulse"

# Optional Fallback Database (SQLite)
# DATABASE_URL="sqlite:///./stockpulse.db"

# Server configuration
HOST="0.0.0.0"
PORT=8000
