# StockPulse AI - Deployment Environment Template
# Copy to .env and adjust variables as needed.
PROJECT_NAME="StockPulse AI"
ENVIRONMENT=demo
DEBUG=False

# Database URL pointing to Windows Host PostgreSQL (use $$ if password contains $)
DATABASE_URL=postgresql+psycopg://postgres:your_password@host.docker.internal:5432/stockpulse

# JWT Secret & Security
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Operational Flags
SECURE_COOKIES=False
CSRF_PROTECTION_ENABLED=True
ALLOW_DEMO_ACCOUNTS=True
ENABLE_DOCS_IN_PRODUCTION=True
BACKEND_PORT=8001

# Optional AI API keys
GEMINI_API_KEY=
GROQ_API_KEY=
